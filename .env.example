# Public Supabase config (safe for browser). Leave unset to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=

# Prefer publishable key (new Supabase API keys). Legacy anon JWT also works.
# Either name is accepted by the app; publishable wins if both are set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# AI gateway mode: demo | byok | enterprise (default demo when unset / demo runtime)
MEDINTEL_AI_MODE=demo

# BYOK: server-side secret reference only — never put raw provider keys in NEXT_PUBLIC_* or localStorage
# MEDINTEL_BYOK_SECRET_REF=
# MEDINTEL_BYOK_SESSION_PRESENT=

# Required canonical application origin for registration, recovery and magic-link redirects.
# Set to https://YOUR-DEPLOYED-DOMAIN in hosted environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: server-only password for provisioned demo accounts (never NEXT_PUBLIC)
# MEDINTEL_DEMO_PASSWORD=

# Optional Turnstile public site key. Enable Turnstile in Supabase Auth and keep
# its secret ONLY in the Supabase dashboard. Configure Auth rate limits there.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Required server-only random secret (32+ characters) for signed recovery cookies.
# Generate out of band and configure the same value on all deployment replicas.
MEDINTEL_AUTH_RECOVERY_SECRET=
