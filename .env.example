# Public Supabase config (safe for browser). Leave unset to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# AI gateway mode: demo | byok | enterprise (default demo when unset / demo runtime)
MEDINTEL_AI_MODE=demo

# BYOK: server-side secret reference only — never put raw provider keys in NEXT_PUBLIC_* or localStorage
# MEDINTEL_BYOK_SECRET_REF=
# MEDINTEL_BYOK_SESSION_PRESENT=
